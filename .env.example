# SHEild — Environment Variables
# Copy this file to .env and fill in your Firebase credentials
# for production mode. Without these, the app runs in Demo Mode.

# Firebase Configuration
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef

# Optional: LLM backend for production AI threat analysis
# VITE_AI_BACKEND_URL=https://your-secure-backend.com/analyze

# Telegram Bot — SOS notifications
# 1. Open Telegram → search @BotFather → /newbot → follow prompts
# 2. Copy the token it gives you and paste below
# 3. Each trusted contact must message your bot at least once to receive messages
VITE_TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# ImgBB — Screenshot storage for Evidence Vault
# Get a free API key at: https://api.imgbb.com/
VITE_IMGBB_API_KEY=770e7dac95730b331cb272ddc97c4ae2
